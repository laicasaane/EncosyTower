<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>10.0</LangVersion>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <IsRoslynComponent>true</IsRoslynComponent>

        <!-- does not need runtime self -->
    </PropertyGroup>

	<ItemGroup>
		<Compile Remove="bin/**" />
		<EmbeddedResource Remove="bin/**" />
		<None Remove="bin/**" />
	</ItemGroup>

	<ItemGroup>
        <!-- Create nuget package as analyzer -->
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../EncosyTower.SourceGen.Common/EncosyTower.SourceGen.Common.csproj" />
      <ProjectReference Include="../EncosyTower.SourceGen.Helpers/EncosyTower.SourceGen.Helpers.csproj" />
      <ProjectReference Include="../EncosyTower.SourceGen.Helpers.Variants/EncosyTower.SourceGen.Helpers.Variants.csproj" />
    </ItemGroup>

</Project>
