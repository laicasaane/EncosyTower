<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="sample-uitk-pages.uss" />
    <ui:VisualElement name="popup-gray" class="sample-popup">
        <ui:VisualElement name="backdrop" class="sample-popup__backdrop" />
        <ui:VisualElement name="root" class="sample-popup__panel sample-popup__panel--gray">
            <ui:Button name="button-open" text="Open Popup &lt;color=#067600&gt;Green&lt;/color&gt;" class="sample-button" />
            <ui:Button name="button-close" text="Close" class="sample-button sample-button--close" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
