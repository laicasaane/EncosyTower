<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:sample="EncosyTower.Samples.UitkPages">
    <ui:Style src="../Views/sample-uitk-pages.uss" />
    <sample:ScreenBlue name="screen-blue" class="sample-screen sample-screen--blue">
        <ui:VisualElement class="sample-screen__buttons">
            <ui:Button name="button-open-screen" text="Open Screen &lt;color=red&gt;Red&lt;/color&gt;" class="sample-button" />
            <ui:Button name="button-open-popup" text="Open Popup &lt;color=#067600&gt;Green&lt;/color&gt;" class="sample-button sample-button--spaced" />
            <ui:Button name="button-close-screen" text="Close This Screen" class="sample-button sample-button--spaced" />
        </ui:VisualElement>
    </sample:ScreenBlue>
</ui:UXML>
