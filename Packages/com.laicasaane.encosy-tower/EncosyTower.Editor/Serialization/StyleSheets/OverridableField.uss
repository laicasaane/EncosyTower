.encosy-overridable {
    flex-direction: column;
}

.encosy-overridable__row {
    flex-direction: row;
    align-items: center;
}

.encosy-overridable__row > .unity-base-field,
.encosy-overridable__row > .unity-property-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.encosy-overridable__override {
    margin-left: 4px;
    flex-shrink: 0;
}

.encosy-overridable__reset {
    min-width: 48px;
    margin-left: 4px;
    margin-right: 0;
    flex-shrink: 0;
}

.encosy-overridable__effective {
    color: var(--encosy-overridable-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: 14px;
    padding: 0 0 0 4px;
    margin: -1px 0 2px 0;
}
