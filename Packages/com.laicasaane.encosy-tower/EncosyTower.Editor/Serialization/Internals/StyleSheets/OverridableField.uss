.encosy-overridable {
    flex-direction: column;
}

.encosy-overridable__row {
    flex-direction: row;
    align-items: center;
}

.encosy-overridable__row > .unity-base-field,
.encosy-overridable__row > .unity-property-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.encosy-overridable__row--collection {
    align-items: flex-start;
}

.encosy-overridable__row--collection > .encosy-overridable__more {
    position: absolute;
    top: 0;
    right: 0;
}

.encosy-overridable__row--collection .encosy-overridable__plain-collection-size--choices {
    right: 14px;
}

.encosy-overridable__row > .encosy-overridable__collection-size--choices {
    position: relative;
    right: auto;
}

.encosy-overridable__field {
    min-width: 0;
}

.encosy-overridable__input {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.encosy-overridable__input > .encosy-overridable__switch {
    align-self: flex-start;
    margin-right: 4px;
}

.encosy-overridable__value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.encosy-overridable__value > .unity-property-field {
    flex-grow: 1;
    min-width: 0;
}

.encosy-overridable__value > .unity-base-field,
.encosy-overridable__quaternion > .unity-vector3-field,
.encosy-overridable__value > .unity-property-field > .unity-base-field {
    margin: 0;
    min-width: 0;
}

.encosy-overridable .unity-composite-field__field-spacer {
    display: none;
}

.encosy-overridable__value .unity-property-field__imgui-container-property {
    margin-left: 0;
    margin-right: 0;
    min-width: 0;
}

.encosy-overridable__value .unity-property-field__imgui-container-property > .unity-imgui-container {
    align-self: stretch;
    width: auto;
    min-width: 0;
    flex-shrink: 1;
}

.encosy-overridable__label--default {
    opacity: 0.5;
}

.encosy-overridable__value--locked > .unity-property-field {
    opacity: 0.5;
}

.encosy-overridable__value--locked > .unity-property-field .unity-disabled,
.encosy-overridable__value--locked > .unity-property-field .encosy-overridable__label--default {
    opacity: 1;
}

.encosy-overridable__more {
    width: 12px;
    min-width: 12px;
    height: 20px;
    flex-shrink: 0;
    padding: 0;
    margin: 0 0 0 2px;
    border-width: 0;
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.encosy-overridable__more:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.encosy-overridable__more-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
}

.encosy-overridable__warning {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-left: 4px;
}

.encosy-overridable__header > .encosy-overridable__field {
    margin-left: 0;
    margin-right: 0;
    overflow: visible;
}

.encosy-overridable__header > .encosy-overridable__field > .unity-base-field__label {
    padding: 0;
    overflow: visible;
}

.encosy-overridable__header-label {
    flex-grow: 1;
    margin: 0;
    color: var(--unity-colors-default-text);
}

.encosy-overridable__header-label > .unity-foldout__toggle {
    margin-top: 0;
    margin-bottom: 0;
}

.encosy-overridable__header-spacer {
    flex-grow: 1;
}

.encosy-overridable__row > .encosy-overridable__collection-size {
    flex-grow: 0;
    flex-shrink: 0;
    top: 0;
}

.encosy-overridable__switch {
    width: 26px;
    height: 18px;
    flex-shrink: 0;
    justify-content: center;
    align-items: flex-start;
}

.encosy-overridable__switch-track {
    width: 24px;
    height: 13px;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 6.5px;
    background-color: var(--encosy-overridable-switch-background);
}

.encosy-overridable__switch-outline {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 1px;
    border-radius: 6.5px;
    border-color: var(--encosy-overridable-switch-border);
    border-top-color: var(--encosy-overridable-switch-border-top);
}

.encosy-overridable__switch-knob {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 9px;
    height: 9px;
    border-radius: 4.5px;
    background-color: var(--encosy-overridable-switch-knob);
    transition-property: left;
    transition-duration: 0.12s;
    transition-timing-function: ease;
}

.encosy-overridable__switch--on > .encosy-overridable__switch-track {
    background-color: var(--encosy-overridable-switch-background-on);
}

.encosy-overridable__switch--on > .encosy-overridable__switch-track > .encosy-overridable__switch-knob {
    left: 13px;
    background-color: var(--encosy-overridable-switch-knob-on);
}

.encosy-overridable__switch-focus-ring {
    display: none;
    position: absolute;
    left: -1px;
    top: -1px;
    right: -1px;
    bottom: -1px;
    border-width: 1px;
    border-radius: 7.5px;
    border-color: var(--encosy-overridable-switch-focus);
}

.encosy-overridable__switch:focus > .encosy-overridable__switch-track > .encosy-overridable__switch-focus-ring {
    display: flex;
}

.encosy-overridable__switch--mixed > .encosy-overridable__switch-track {
    background-color: var(--encosy-overridable-switch-background);
}

.encosy-overridable__switch--mixed > .encosy-overridable__switch-track > .encosy-overridable__switch-knob {
    left: 8px;
    top: 5.5px;
    width: 8px;
    height: 2px;
    border-radius: 0;
    background-color: var(--encosy-overridable-switch-knob);
}
