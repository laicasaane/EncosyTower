<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:attachments="EncosyTower.Samples.UitkPages.Attachments" xmlns:views="EncosyTower.Samples.UitkPages.Views">
    <ui:Style src="../../../UI/sample-uitk-pages.uss" />
    <attachments:NavigationBarPage name="navigation-bar" class="tower-book-navigation-bar">
        <ui:Button name="button-back" class="tower-book-button">
            <ui:VisualElement class="tower-book-navigation-bar__icon tower-book-navigation-bar__icon--back" picking-mode="Ignore" />
        </ui:Button>
        <ui:Button name="button-forward" class="tower-book-button">
            <ui:VisualElement class="tower-book-navigation-bar__icon tower-book-navigation-bar__icon--forward" picking-mode="Ignore" />
        </ui:Button>
        <ui:VisualElement class="tower-book-navigation-bar__spacer" picking-mode="Ignore" />
        <ui:Button name="button-map" text="Map" class="tower-book-button" />
        <ui:Button name="button-settings" text="Settings" class="tower-book-button" />
    </attachments:NavigationBarPage>
</ui:UXML>
